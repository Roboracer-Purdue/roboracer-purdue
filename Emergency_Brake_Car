import math
import rclpy
from rclpy.node import Node
from sensor_msgs.msg import LaserScan
from ackermann_msgs.msg import AckermannDriveStamped
from rclpy.qos import QoSProfile, ReliabilityPolicy, HistoryPolicy

class SimpleDriver(Node):
    def __init__(self):
        super().__init__('simple_driver')

        # Using /ackermann_cmd to talk directly to the VESC driver
        qos_profile = QoSProfile(
            reliability=ReliabilityPolicy.RELIABLE,
            history=HistoryPolicy.KEEP_LAST,
            depth=1
        )

        self.drive_pub = self.create_publisher(
            AckermannDriveStamped,
            '/ackermann_cmd',
            qos_profile
        )

        # === LIDAR ===
        self.scan_sub = self.create_subscription(
            LaserScan,
            '/scan',
            self.scan_callback,
            10
        )

        self.timer = self.create_timer(0.1, self.drive_loop)
        self.min_distance = 999.0
        self.brake_distance = 1.0  # meters

    def scan_callback(self, msg: LaserScan):
        ranges = msg.ranges
        if not ranges:
            return

        # Assuming 0.0 is front based on your earlier code
        forward_angle = 0.0  
        forward_idx = int((forward_angle - msg.angle_min) / msg.angle_increment)
        forward_idx = max(0, min(len(ranges) - 1, forward_idx))

        window = 20
        start = max(0, forward_idx - window)
        end = min(len(ranges), forward_idx + window)

        valid = [d for d in ranges[start:end] if d > msg.range_min and not math.isnan(d)]
        self.min_distance = min(valid) if valid else 999.0

    def drive_loop(self):
        msg = AckermannDriveStamped()
        msg.header.stamp = self.get_clock().now().to_msg()
        msg.header.frame_id = "base_link"

        if self.min_distance < self.brake_distance:
            msg.drive.speed = 0.0
            #msg.drive.acceleration = -5.0 # Helps prevent "coasting" into a wall
            self.get_logger().warn(f"STOP! Obstacle at {self.min_distance:.2f}m")
        else:
            # 0.5 m/s is a safe testing speed.
            msg.drive.speed = 10.0
            msg.drive.steering_angle = 0.0

        self.drive_pub.publish(msg)

def main(args=None):
    rclpy.init(args=args)
    node = SimpleDriver()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()
